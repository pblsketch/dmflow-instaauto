# ============================================================
# dmflow 환경 변수 예시
# ------------------------------------------------------------
# · 비개발자용 설치 가이드: docs/setup-guide.md (한국어)
# · Vercel 배포 시: Vercel 프로젝트 → Settings → Environment Variables
# · 로컬 실행 시: 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#
# ⚠️ 이 파일(.env.example)은 공개되어도 안전한 "빈 양식"입니다.
#    실제 비밀값이 들어간 .env.local 은 절대 커밋/공유하지 마세요.
# ============================================================

# ── 1. Supabase (필수) ──────────────────────────────────────
# supabase.com → 내 프로젝트 → Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ⚠️ service_role 키는 서버 전용 관리자 키입니다. 절대 공개/공유하지 마세요.

# ── 2. 대시보드 접속 로그인 (필수) ─────────────────────────
# 내가 직접 정하는 아이디/비밀번호입니다 (예: DASH_USER=dmflow, DASH_PASS=원하는비번).
# 설정하지 않으면 배포 후 사이트가 503 "Auth not configured" 로 열리지 않습니다.
DASH_USER=
DASH_PASS=

# ── 3. Instagram / Meta 앱 (필수) ──────────────────────────
# "Instagram API with Instagram Login" 방식입니다 (Facebook 로그인 아님).
# developers.facebook.com → 내 앱 → Instagram → "API setup with Instagram business login" 에서:
#   ★ 아래에는 [Instagram 앱 ID / Instagram 앱 시크릿] 을 넣습니다.
#     (Settings → Basic 에 있는 "Meta 앱 ID" 가 아닙니다 — 가장 흔한 실수!)
NEXT_PUBLIC_INSTAGRAM_APP_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# OAuth 리다이렉트 주소 — Meta의 "Business login settings"에 등록한 값과
# 문자 단위로 정확히 일치해야 합니다 (스킴·주소·경로·끝 슬래시까지).
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# 웹훅 검증 토큰 — 아무 긴 랜덤 문자열이나 OK. Meta 웹훅 설정 화면에 같은 값을 입력하세요.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# (선택) 상위 Meta 앱의 시크릿 (Settings → Basic).
# 웹훅 서명 검증이 계속 401로 실패할 때만 필요합니다.
META_APP_SECRET=

# ── 4. AI 자동 답장 (선택) ─────────────────────────────────
# console.groq.com 에서 무료 키 발급 (권장, 빠르고 무료) — 또는 OpenAI 호환 서비스 아무거나.
GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=llama-3.1-8b-instant
# (AI 키/모델은 배포 후 대시보드 → 자동 답장 → "AI 도우미 설정"에서도 입력할 수 있어요.)

# (선택) AI 답장 끝에 붙일 자동 응답 고지 문구. 비워두면 아무것도 붙지 않습니다.
# 예: AI_REPLY_DISCLOSURE=🤖 자동 응답입니다
AI_REPLY_DISCLOSURE=

# ── 5. AI 에이전트 API (선택) ──────────────────────────────
# Muse·MCP 같은 AI 도구가 이 앱을 원격 조작할 때 쓰는 API 키입니다.
# 사용하지 않는다면 비워두세요. 설정 시 아무 긴 랜덤 문자열이면 됩니다.
AGENT_API_KEY=

# ── 6. 개인정보처리방침 연락처 (선택) ──────────────────────
# /privacy 페이지에 표시될 문의 이메일입니다. Meta 앱 설정에도 같은 URL(/privacy)을 등록합니다.
# 비워두면 your-email@example.com 로 표시됩니다.
PRIVACY_CONTACT_EMAIL=
